# Application Envoirment 
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/
CLIENT_URL=http://localhost:5173/

# Database Configuration
MONGO_URI=mongodb://localhost:27017/kanbrix?replicaSet=rs0

#Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=localhost

# local Email Testing (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=your_smtp_user    
SMTP_PASS=your_smtp_password
EMAIL_FROM=Kanbrix <no-reply@kanbrix.app>

# File Storage Configuration (local | s3 | cloudinary)
STORAGE_DRIVER=local
S3_BUCKET= 
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX__FILE_SIZE_MB=10 # 10MB

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logging & API Documentation
LOG_LEVEL=debug
ENABLE_SWAGGER=true